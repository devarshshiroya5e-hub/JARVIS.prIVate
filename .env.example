# GEMINI_API_KEY: Server-side fallback AI key. Required when OpenRouter is unavailable,
# including OpenRouter HTTP 402 (no credits), 401/403, rate limits, or outages.
# Add this secret to Render as GEMINI_API_KEY.
GEMINI_API_KEY=""

# GEMINI_FALLBACK_MODEL: Gemini model used automatically when OpenRouter cannot serve a request.
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

# OPENROUTER_API_KEY: Primary AI provider key.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Default OpenRouter model identifier.
OPENROUTER_MODEL="openai/gpt-4o-mini"

# APP_URL: Public URL where this app is hosted.
APP_URL=""
